# Set to "production" when deploying behind HTTPS. Leave unset for local testing -
# production mode makes the admin session cookie secure-only and disables FLUXER_STUB_MODE.
NODE_ENV=

# Postgres
DB_NAME=shopclock
DB_USER=shopclock
DB_PASSWORD=change-me

# Shared bearer token used by the kiosk-admin /clock/* routes
API_BEARER_TOKEN=change-me

# Admin panel session signing - required, long random string, no default
ADMIN_JWT_SECRET=change-me
ADMIN_SESSION_TTL_SECONDS=28800

# Public URL of the admin frontend (this compose setup serves it on :8080).
# Used for CORS and as the Fluxer OAuth redirect target after login.
ADMIN_FRONTEND_URL=http://localhost:8080

# Fluxer OAuth2 (Discord-style authorize/token/user flow)
FLUXER_CLIENT_ID=
FLUXER_CLIENT_SECRET=
FLUXER_AUTHORIZE_URL=
FLUXER_TOKEN_URL=
FLUXER_USER_URL=
FLUXER_REDIRECT_URI=http://localhost:3000/api/admin/auth/fluxer/callback
FLUXER_SCOPES=identify

# Comma-separated Fluxer user IDs allowed to log in as admins
ADMIN_FLUXER_ALLOWED_IDS=

# Fakes the whole Fluxer OAuth round trip for local testing. Never enable in production.
FLUXER_STUB_MODE=false

# Public URL of the backend API, baked into the admin app's JS at build time.
# Must be reachable from the browser - NOT the internal "backend" Docker hostname.
ADMIN_API_BASE_URL=http://localhost:3000/api
